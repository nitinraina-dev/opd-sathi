# Copy to server/.env and change as needed. Everything here is optional.

# MongoDB connection. Local default shown; for Atlas use your mongodb+srv:// link.
MONGODB_URI=mongodb://127.0.0.1:27017/opd-saathi

# Port for the API (the React dev server passes /api here).
PORT=5050

# The hospital's time zone. Breaks, bookings and the forecast use the server's
# clock; hosting services run on UTC. (render.yaml and the Dockerfile set it.)
# TZ=Asia/Kolkata

# Password for the "admin" account made on the very first start.
# If empty, a random one is printed once in the terminal.
STAFF_ADMIN_PASSWORD=

# Key that signs staff login cookies. If empty, one is made and kept in the database.
SESSION_SECRET=

# Key that encrypts payment key secrets in the database. Set it in production
# (any long random text). If empty, one is made and kept in the database.
SECRETS_KEY=

# Web-push keys for phone alerts. If empty, they are made once and kept in the database.
# (Make your own with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

# Optional: n8n webhook links. They can also be set on the staff Forecast screen.
N8N_EVENTS_URL=
N8N_FEED_URL=

# Optional: only if the React app is hosted on a different domain.
CLIENT_ORIGIN=

# Phone registrations allowed per internet address every 10 minutes (the
# registration counter is never limited). Many phones can share one address.
# REGISTER_LIMIT=20

# Local news for the forecast: the server reads Google News headlines for the
# town set on the Forecast screen (no key needed). NEWS=off stops it.
# NEWS=off

# "Ask" voice helper: with a Gemini API key (Google AI Studio), Gemini
# understands patients' questions; without one, simple word matching answers.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# SMS replies (any phone): the key your SMS gateway / n8n sends in the
# x-opd-sms-key header to POST /api/sms/inbound.
# SMS_KEY=

# Telegram for patients and families (free): replies like SMS, and alerts for
# a token they follow. Make a bot with @BotFather and paste its token here.
# TELEGRAM_BOT_TOKEN=
