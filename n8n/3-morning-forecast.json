      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.apiBase }}/api/forecast?lang={{ $json.lang }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "bdb32940-dc64-4c4a-8b8f-ff655627f23b",
      "name": "Get today's forecast",
