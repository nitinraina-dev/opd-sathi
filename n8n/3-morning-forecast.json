    {
      "parameters": {
        "jsCode": "// Change these.\nreturn [{\n  json: {\n    // Where the OPD Saathi server runs (must be reachable from n8n).\n    apiBase: 'http://localhost:5050',\n    telegramChatId: 'PUT-YOUR-STAFF-GROUP-CHAT-ID',\n    lang: 'en', // or 'hi'\n  },\n}];\n"
      },
